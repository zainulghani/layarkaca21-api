generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Movie {
  id             String    @id @default(uuid())
  title          String
  original_title String?
  slug           String    @unique
  poster         String?
  backdrop       String?
  description    String?
  language       String?
  release_date   DateTime?
  year           Int?
  runtime        Int?
  rating         Float?
  status         String?
  thumbnail      String?
  last_updated   DateTime  @updatedAt

  genres    Genre[]
  countries Country[]
  directors Person[]  @relation("MovieDirectors")
  writers   Person[]  @relation("MovieWriters")
  cast      Person[]  @relation("MovieCast")
  studios   Studio[]
  tags      Tag[]

  @@index([slug])
  @@index([year])
  @@index([rating])
}

model Series {
  id             String    @id @default(uuid())
  title          String
  slug           String    @unique
  poster         String?
  description    String?
  rating         Float?
  year           Int?
  status         String?
  total_episodes Int?
  last_updated   DateTime  @updatedAt

  genres    Genre[]
  countries Country[]
  studios   Studio[]
  episodes  Episode[]

  @@index([slug])
  @@index([year])
}

model Episode {
  id             String    @id @default(uuid())
  title          String
  slug           String    @unique
  episode_number Int
  season_number  Int
  thumbnail      String?
  release_date   DateTime?

  seriesId String
  series   Series @relation(fields: [seriesId], references: [id])

  @@index([seriesId])
}

model Genre {
  id     String   @id @default(uuid())
  name   String   @unique
  slug   String   @unique
  movies Movie[]
  series Series[]
}

model Country {
  id     String   @id @default(uuid())
  name   String   @unique
  slug   String   @unique
  movies Movie[]
  series Series[]
}

model Person {
  id     String  @id @default(uuid())
  name   String  @unique
  slug   String  @unique

  directedMovies Movie[] @relation("MovieDirectors")
  writtenMovies  Movie[] @relation("MovieWriters")
  actedInMovies  Movie[] @relation("MovieCast")
}

model Studio {
  id     String   @id @default(uuid())
  name   String   @unique
  slug   String   @unique
  movies Movie[]
  series Series[]
}

model Tag {
  id     String @id @default(uuid())
  name   String @unique
  movies Movie[]
}

// Credit of a person (actor / director) on a title.
//
// The upstream catalogue has no person pages on every theme, so credits are
// harvested from the JSON-LD `actor` array of the detail pages and from the
// `muvicast` taxonomy of the grid theme. They are stored here so the person
// endpoints stay fast and keep working for titles that are no longer listed
// on the front page.
model ActorCredit {
  id         String   @id @default(uuid())
  personSlug String
  personName String
  titleSlug  String
  title      String
  type       String // movie | series
  year       Int?
  poster     String?
  rating     Float?
  url        String?
  source     String // jsonld | muvicast
  createdAt  DateTime @default(now())

  @@unique([personSlug, titleSlug, type])
  @@index([personSlug])
  @@index([titleSlug])
  @@index([type])
}

// Cursor of the incremental credit crawler.
model CrawlState {
  id        String   @id @default(uuid())
  label     String   @unique
  cursor    Int      @default(1)
  updatedAt DateTime @updatedAt
}
